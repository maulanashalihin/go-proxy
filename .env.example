# sample config, copy to .env
# Any target website. Example: https://dulak.pages.dev
TARGET_URL=https://dulak.pages.dev

# Port this proxy service listens on (customize via .env)
PORT=8080

# Cache
CACHE_DIR=./cache
CACHE_ENABLED=true
CACHE_MAX_SIZE_MB=1024

# TTL per content type (Go duration format: 5m, 1h, 24h, 168h)
TTL_HTML=5m
TTL_CSS=1h
TTL_JS=1h
TTL_IMAGE=24h
TTL_PDF=7d
TTL_DEFAULT=10m

# Rewrite absolute origin URLs -> relative proxy paths so assets stay behind the proxy
REWRITE_HTML=true
REWRITE_CSS=true
REWRITE_JS=false

# Timeout to origin
ORIGIN_TIMEOUT=30s

# Token to purge cache: GET /__purge?url=/path or /__purge-all
# Leave empty to disable protection (not recommended on public hosts)
PURGE_TOKEN=changeme
